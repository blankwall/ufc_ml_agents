+def extract_underdog_specialization_advantage(
+    fight_history: pd.DataFrame
+) -> Dict[str, float]:
+    """
+    Calculate underdog specialization advantage score.
+
+    This feature identifies fighters with elite specialized skills that can lead
+    to upset victories. Specialized fighters (e.g., elite submission artists,
+    knockout artists, wrestlers) often win as underdogs when their strength
+    aligns against opponents who are vulnerable to that style.
+
+    Formula:
+        specialization_score = max(
+            finish_rate × finish_bonus,
+            ko_rate × ko_bonus,
+            submission_rate × submission_bonus
+        )
+        Where finish_bonus = 1.5 (finishes create upset potential)
+              ko_bonus = 1.3 (KO power is a great equalizer)
+              submission_bonus = 1.4 (submissions can catch anyone)
+
+    Args:
+        fight_history: DataFrame with fight history (sorted most recent first)
+
+    Returns:
+        Dictionary with underdog_specialization_advantage feature
+    """
+    if len(fight_history) == 0:
+        return {
+            "underdog_specialization_advantage": 0.0,
+        }
+
+    # Calculate finish rate
+    total_fights = len(fight_history)
+    wins = (fight_history["result"] == "win").sum()
+
+    if wins == 0:
+        return {
+            "underdog_specialization_advantage": 0.0,
+        }
+
+    method_series = fight_history["method"].astype(str)
+
+    # Count wins by method
+    win_rows = fight_history[fight_history["result"] == "win"]
+
+    # KO/TKO wins
+    ko_mask = method_series.str.contains("KO|TKO", case=False, na=False)
+    ko_wins = ((fight_history["result"] == "win") & ko_mask).sum()
+
+    # Submission wins
+    sub_mask = method_series.str.contains("SUB|Submission", case=False, na=False)
+    sub_wins = ((fight_history["result"] == "win") & sub_mask).sum()
+
+    # Total finish wins
+    finish_wins = ko_wins + sub_wins
+
+    # Calculate rates
+    finish_rate = safe_divide(finish_wins, wins, default=0.0)
+    ko_rate = safe_divide(ko_wins, wins, default=0.0)
+    submission_rate = safe_divide(sub_wins, wins, default=0.0)
+
+    # Calculate specialization scores with bonuses
+    # Finishes create upset potential (bonus multiplier 1.5)
+    finish_specialization = finish_rate * 1.5
+
+    # KO power is a great equalizer (bonus multiplier 1.3)
+    ko_specialization = ko_rate * 1.3
+
+    # Submissions can catch anyone (bonus multiplier 1.4)
+    submission_specialization = submission_rate * 1.4
+
+    # Take the maximum specialization score
+    # This captures the fighter's primary upset vector
+    underdog_specialization_advantage = max(
+        finish_specialization,
+        ko_specialization,
+        submission_specialization
+    )
+
+    # Cap at 1.0 to keep feature in [0, 1] range
+    underdog_specialization_advantage = min(1.0, underdog_specialization_advantage)
+
+    return {
+        "underdog_specialization_advantage": float(underdog_specialization_advantage),
+    }
