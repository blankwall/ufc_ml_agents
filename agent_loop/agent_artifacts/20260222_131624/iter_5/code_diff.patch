+def extract_underdog_upset_potential(
+    striking_volume_control: float,
+    age: float,
+    recent_form_quality_adjusted: float,
+) -> float:
+    """
+    Calculate underdog upset potential score.
+
+    Combines three key upset indicators:
+    1. Striking volume control (offensive output)
+    2. Age (younger fighters have more upset potential)
+    3. Recent form quality adjusted (momentum against opponents)
+
+    Formula:
+        upset_potential = (
+            striking_volume_control × 0.4 +
+            youth_factor × 0.3 +
+            recent_form_quality × 0.3
+        )
+        Where youth_factor = max(0, 1 - age/40) for younger fighters
+
+    This helps identify fighters who may be undervalued as underdogs because
+    they have offensive output, youth, and positive momentum - factors the
+    market may underestimate for underdogs.
+
+    Args:
+        striking_volume_control: Volume control score (0.0 to 1.0)
+        age: Fighter age
+        recent_form_quality_adjusted: Recent form adjusted for opponent quality (0.0 to 1.0)
+
+    Returns:
+        Underdog upset potential score (0.0 to 1.0)
+    """
+    try:
+        striking_volume = float(striking_volume_control or 0.0)
+        age_val = float(age or 0.0)
+        recent_form = float(recent_form_quality_adjusted or 0.0)
+
+        # Youth factor: peaks at low age, decreases to 0 at age 40
+        # Fighters under 25 get maximum bonus, 25-35 get partial, 35+ get minimal
+        youth_factor = max(0.0, 1.0 - (age_val / 40.0))
+
+        # Combine components with weights
+        # Striking volume (40%): offensive output creates upset opportunities
+        # Youth (30%): physical attributes and improvement potential
+        # Recent form (30%): momentum and confidence
+        upset_potential = (
+            striking_volume * 0.4 +
+            youth_factor * 0.3 +
+            recent_form * 0.3
+        )
+
+        # Normalize to [0, 1] range
+        upset_potential = max(0.0, min(1.0, upset_potential))
+
+        return float(upset_potential)
+    except Exception:
+        return 0.0
