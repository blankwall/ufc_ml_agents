+def extract_recent_improvement_score(
+    fight_history: pd.DataFrame
+) -> Dict[str, float]:
+    """
+    Calculate recent improvement score by comparing last 2 fights to previous 5.
+
+    This feature captures fighters on upward trajectories by comparing their
+    recent performance (last 2 fights) to their earlier performance (fights 3-7).
+    A positive score indicates improvement, which can help identify underdogs
+    with positive momentum that odds may not fully reflect.
+
+    Formula:
+        recent_improvement_score = win_rate_last_2 - win_rate_previous_5
+
+    Args:
+        fight_history: DataFrame with fight history (sorted most recent first)
+
+    Returns:
+        Dictionary with recent_improvement_score feature
+    """
+    if len(fight_history) < 3:
+        # Not enough fights to calculate meaningful improvement
+        return {
+            "recent_improvement_score": 0.0,
+        }
+
+    # Last 2 fights (most recent)
+    last_2 = fight_history.head(2)
+    wins_last_2 = (last_2['result'] == 'win').sum()
+    win_rate_last_2 = safe_divide(wins_last_2, len(last_2))
+
+    # Previous 5 fights (fights 3-7, if available)
+    previous_5 = fight_history.iloc[2:7]
+    if len(previous_5) == 0:
+        # Only have 2 fights total, use career win rate as baseline
+        all_wins = (fight_history['result'] == 'win').sum()
+        win_rate_previous = safe_divide(all_wins - wins_last_2, len(fight_history) - len(last_2))
+    else:
+        wins_previous_5 = (previous_5['result'] == 'win').sum()
+        win_rate_previous = safe_divide(wins_previous_5, len(previous_5))
+
+    # Improvement score: positive = getting better, negative = declining
+    recent_improvement_score = win_rate_last_2 - win_rate_previous
+
+    return {
+        "recent_improvement_score": float(recent_improvement_score),
+    }
+
