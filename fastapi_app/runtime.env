# FastAPI app runtime sync config.
# run.sh sources this file and exports these variables before starting Uvicorn.

# The Odds API
THE_ODDS_API_KEY=
THE_ODDS_API_AUTO_SYNC=1
THE_ODDS_API_SYNC_INTERVAL_HOURS=24
THE_ODDS_API_SYNC_CHECK_SECONDS=3600
THE_ODDS_API_WINDOW_DAYS=31

# UFCStats completed-event ingestion
UFCSTATS_AUTO_SYNC=1
UFCSTATS_SYNC_INTERVAL_HOURS=24
UFCSTATS_SYNC_CHECK_SECONDS=3600
UFCSTATS_COMPLETED_LOOKBACK_DAYS=14
UFCSTATS_COMPLETED_MAX_PAGES=1
UFCSTATS_COMPLETED_MIN_FIGHTS=5
UFCSTATS_COMPLETED_MAX_EVENTS_PER_RUN=1
